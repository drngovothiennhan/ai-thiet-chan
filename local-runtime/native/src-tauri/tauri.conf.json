{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "A.I Thiet Chan Local",
  "version": "0.1.0",
  "identifier": "vn.hiu.yhct.aithietchan.local",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "A.I Thiet Chan Local",
        "width": 1180,
        "height": 820,
        "minWidth": 360,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self' https:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "android": {
      "minSdkVersion": 28
    }
  }
}
