{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-thiet-chan.local/schemas/aitc-pack-manifest-v1.schema.json",
  "title": "AITC Pack Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "packId",
    "version",
    "createdAt",
    "minimumAppVersion",
    "artifacts",
    "signature"
  ],
  "properties": {
    "schemaVersion": {
      "const": "aitc-pack-manifest-v1"
    },
    "packId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "minimumAppVersion": {
      "type": "string",
      "minLength": 1
    },
    "releaseNotes": {
      "type": "string"
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "version",
          "path",
          "size",
          "sha256",
          "platforms"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "enum": [
              "vision-model",
              "text-model",
              "knowledge-db",
              "ontology",
              "rules",
              "atlas",
              "prompt-pack",
              "runtime-config",
              "other"
            ]
          },
          "version": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "size": {
            "type": "integer",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "items": {
              "enum": [
                "android",
                "windows",
                "ios",
                "macos",
                "all"
              ]
            }
          },
          "minRuntimeVersion": {
            "type": "string"
          },
          "hardwareConstraints": {
            "type": "object",
            "additionalProperties": true
          },
          "encrypted": {
            "type": "boolean",
            "default": true
          }
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "algorithm",
        "keyId",
        "value"
      ],
      "properties": {
        "algorithm": {
          "const": "Ed25519"
        },
        "keyId": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
